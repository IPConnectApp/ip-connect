@{
    ViewData["Title"] = "Chats";
    Layout = "_ProfileLayout";
}

<div class="tab-content-header">
    <h1>Chats</h1>
</div>

<!-- Search Bar -->
<div class="chat-search-container">
    <i class="fas fa-search search-icon"></i>
    <input type="text" id="userSearchInput" class="chat-search-input" placeholder="Search users to start chatting..."
        autocomplete="off" />

    <div id="searchResults" class="search-results-dropdown" style="display: none;"></div>
</div>

<!-- Private Chats Section -->
<div class="chats-section">
    <h3 class="section-title"><i class="fas fa-comments"></i> Private Chats</h3>
    <div id="privateChats" class="chat-list">
        <p class="no-chats-message">No conversations yet. Search for users to start chatting!</p>
    </div>
</div>

<!-- Chat Modal -->
<div id="chatModal" class="chat-modal" style="display: none;">
    <div class="chat-modal-content">
        <!-- Modal Header -->
        <div class="chat-modal-header">
            <div class="chat-modal-user-info">
                <img id="modalUserAvatar" src="" alt="" class="chat-modal-avatar">
                <span id="modalUsername" class="chat-modal-username"></span>
            </div>
            <button class="chat-modal-close" onclick="closeChatModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Messages Area -->
        <div class="chat-modal-messages" id="chatMessages">
            <!-- Messages will be loaded here -->
        </div>

        <!-- Input Area -->
        <div class="chat-modal-input">
            <button class="chat-emoji-button" id="emojiButton" type="button">
                <i class="far fa-smile"></i>
            </button>
            <input type="text" id="messageInput" class="chat-message-input" placeholder="Type a message..."
                autocomplete="off">
            <button class="chat-send-button" onclick="sendMessage()">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>

        <!-- Emoji Picker Container (hidden by default) -->
        <div id="emojiPickerContainer" class="emoji-picker-container" style="display: none;">
            <emoji-picker></emoji-picker>
        </div>
    </div>
</div>

<!-- Pass current username to JavaScript -->
<script>
    window.currentUsername = '@User.Identity?.Name';
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/profile/chat.css" />
}

@section Scripts {
    <script type="module">
        import 'https://cdn.jsdelivr.net/npm/emoji-picker-element@1.21.3/index.js';
    </script>
    <script type="module" src="/js/profile/chat.js"></script>
}