@{
    ViewData["Title"] = "Photos";
    Layout = "_ProfileLayout";
    var isOwnProfile = ViewData["IsOwnProfile"] as bool? ?? false;
    var areFriends = ViewData["AreFriends"] as bool? ?? false;
    var profileUserId = ViewData["ProfileUserId"]?.ToString() ?? "";
}

@if (isOwnProfile || areFriends)
{
    <div class="tab-content-header">
        <div class="tab-header-row">
            <h1>Photos</h1>
            @if (isOwnProfile)
            {
                <button class="btn-create-album" onclick="openCreateAlbumModal()">
                    <i class="fas fa-plus"></i> Create Album
                </button>
            }
        </div>
    </div>

    <!-- Albums Grid -->
    <div class="albums-container">
        <div id="albumsGrid" class="albums-grid">
            <!-- Albums will be loaded here by JavaScript -->
        </div>

        <!-- Empty State (shown when no albums exist) -->
        <div id="emptyAlbums" class="empty-albums" style="display: none;">
            <i class="fas fa-images"></i>
            <h3>No Albums Yet</h3>
            @if (isOwnProfile)
            {
                <p>Create your first album to start sharing photos!</p>
            }
            else
            {
                <p>@ViewData["Username"] doesn't have any albums yet.</p>
            }
        </div>
    </div>

    <!-- Create Album Modal -->
    @if (isOwnProfile)
    {
        <div id="createAlbumModal" class="modal-overlay" style="display: none;">
            <div class="ip-modal">
                <div class="ip-modal-header">
                    <h3><i class="fas fa-folder-plus"></i> Create Album</h3>
                    <button class="ip-modal-close" onclick="closeCreateAlbumModal()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="ip-modal-body">
                    <div class="ip-modal-form-group">
                        <label for="albumName">Album Name</label>
                        <input type="text" id="albumName" class="ip-modal-form-input" placeholder="Enter album name..."
                            maxlength="100">
                        <span id="albumNameError" class="ip-modal-form-error" style="display: none;"></span>
                    </div>
                    <div class="ip-modal-form-group">
                        <label for="albumDescription">Description (optional)</label>
                        <textarea id="albumDescription" class="ip-modal-form-textarea" placeholder="Add a description..."
                    maxlength="500"></textarea>
                    </div>
                </div>
                <div class="ip-modal-footer">
                    <button class="btn-ip-modal-cancel" onclick="closeCreateAlbumModal()">Cancel</button>
                    <button class="btn-ip-modal-submit" onclick="createAlbum()">
                        <i class="fas fa-folder-plus"></i> Create Album
                    </button>
                </div>
            </div>
        </div>

        <!-- Edit Album Modal -->
        <div id="editAlbumModal" class="modal-overlay" style="display: none;">
            <div class="ip-modal">
                <div class="ip-modal-header">
                    <h3><i class="fas fa-edit"></i> Edit Album</h3>
                    <button class="ip-modal-close" onclick="closeEditAlbumModal()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="ip-modal-body">
                    <input type="hidden" id="editAlbumId">
                    <div class="ip-modal-form-group">
                        <label for="editAlbumName">Album Name</label>
                        <input type="text" id="editAlbumName" class="ip-modal-form-input" placeholder="Enter album name..."
                            maxlength="100">
                        <span id="editAlbumNameError" class="ip-modal-form-error" style="display: none;"></span>
                    </div>
                    <div class="ip-modal-form-group">
                        <label for="editAlbumDescription">Description (optional)</label>
                        <textarea id="editAlbumDescription" class="ip-modal-form-textarea" placeholder="Add a description..."
                    maxlength="500"></textarea>
                    </div>
                </div>
                <div class="ip-modal-footer">
                    <button class="btn-ip-modal-cancel" onclick="closeEditAlbumModal()">Cancel</button>
                    <button class="btn-ip-modal-submit" onclick="updateAlbum()">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                </div>
            </div>
        </div>

        <!-- Delete Confirmation Modal -->
        <div id="deleteAlbumModal" class="modal-overlay" style="display: none;">
            <div class="ip-modal ip-modal-small">
                <div class="ip-modal-header">
                    <h3><i class="fas fa-trash-alt"></i> Delete Album</h3>
                    <button class="ip-modal-close" onclick="closeDeleteAlbumModal()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="ip-modal-body">
                    <p class="ip-modal-confirm-text">Are you sure you want to delete "<span id="deleteAlbumName"></span>"? This
                        action cannot be undone!</p>
                </div>
                <div class="ip-modal-footer">
                    <button class="btn-ip-modal-cancel" onclick="closeDeleteAlbumModal()">Cancel</button>
                    <button class="btn-ip-modal-delete" onclick="confirmDeleteAlbum()">
                        <i class="fas fa-trash-alt"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    }
}
else
{
    var hasPendingRequest = ViewData["HasPendingRequest"] as bool? ?? false;

    <div class="restricted-content">
        <div class="restricted-card">
            <i class="fas fa-lock"></i>
            <h3>This Content is Private</h3>
            <p>You need to be friends with @ViewData["Username"] to view their photos.</p>
            @if (hasPendingRequest)
            {
                <button class="btn-pending-large" disabled>
                    <i class="fas fa-clock"></i> Pending
                </button>
            }
            else
            {
                <button class="btn-add-friend-large" onclick="sendFriendRequest('@profileUserId')">
                    <i class="fas fa-user-plus"></i> Add Friend
                </button>
            }
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile/friends.css" />
    <link rel="stylesheet" href="~/css/profile/albums.css" />
}

@section Scripts {
    <script src="~/js/profile/friends.js"></script>
    <script>
        // Pass data to albums.js
        window.albumsConfig = {
            isOwnProfile: @Json.Serialize(isOwnProfile),
            profileUserId: '@profileUserId'
        };
    </script>
    <script src="~/js/profile/albums.js"></script>
}