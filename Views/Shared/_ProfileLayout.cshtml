@using Microsoft.AspNetCore.Identity
@using ip_connect.Models
@using ip_connect.Services.UserProfileService
@inject UserManager<ApplicationUser> UserManager
@inject IUserProfileService ProfileService

@{
    var username = ViewData["Username"]?.ToString() ?? User.Identity?.Name ?? "";
    var currentTab = ViewData["CurrentTab"]?.ToString() ?? "Photos";
    var isOwnProfile = User.Identity?.Name == username;
    var profilePicUrl = ViewData["ProfilePictureUrl"]?.ToString() ?? "/images/default-avatar.jpg";

    string displayName = username;
    string gender = "Not specified";
    string age = "";
    string joinedDate = "";
    string bio = "";

    var user = await UserManager.FindByNameAsync(username);
    if (user != null)
    {
        var profile = await ProfileService.GetOrCreateProfileAsync(user.Id, user.UserName);

        displayName = profile.DisplayName;
        gender = profile.Gender ?? "Not specified";
        bio = profile.Bio;
        joinedDate = profile.CreatedAt.ToString("MMMM yyyy");

        //missing location

        if (profile.BirthDate.HasValue)
        {
            var today = DateTime.Today;
            var birthDate = profile.BirthDate.Value;
            var a = today.Year - birthDate.Year;
            if (birthDate.Date > today.AddYears(-a)) a--;
            age = $", {a}";
        }
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IP Connect</title>

    <link rel="stylesheet" href="~/css/variables.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/profile/profile.css" />
    <link rel="stylesheet" href="~/css/profile/settings.css" />

    <!-- SignalR Client Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/global-signalr.js"></script>
    <script src="~/js/profile/profile-badge.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <!-- Top Navbar -->
    @await Html.PartialAsync("_Navbar")

    <!-- Profile Container -->
    <div class="profile-container">
        <!-- Left Sidebar -->
        <aside class="profile-sidebar">
            <div class="profile-picture">
                <img src="@profilePicUrl" alt="Profile Picture" />
            </div>
            <h2 class="profile-name">@displayName</h2>

            <div class="profile-info">
                <p><i class="fas fa-venus-mars"></i> @gender@age</p>

                <p><i class="fas fa-calendar"></i> Joined @joinedDate</p>
            </div>

            <div class="profile-bio">
                <p>
                    @if (!string.IsNullOrEmpty(bio))
                    {
                        @bio
                    }
                    else
                    {
                        <span class="text-muted" style="font-style: italic; font-size: 0.9em;">
                            No bio provided yet.
                        </span>
                    }
                </p>
            </div>
        </aside>

        <!-- Right Content Area -->
        <main class="profile-content">
            <!-- Tab Navigation -->
            <nav class="profile-tabs">
                <a href="/profile/@username/photos" class="profile-tab @(currentTab == "Photos" ? "active" : "")">
                    <i class="fas fa-images"></i> Photos
                </a>
                <a href="/profile/@username/friends" class="profile-tab @(currentTab == "Friends" ? "active" : "")">
                    <i class="fas fa-user-friends"></i> Friends
                </a>

                @if (isOwnProfile)
                {
                    <a href="/profile/@username/chats" class="profile-tab @(currentTab == "Chats" ? "active" : "")">
                        <i class="fas fa-comments"></i> Chats
                        <span id="profileUnreadBadge" class="profile-tab-badge" style="display: none;">0</span>
                    </a>
                    <a href="/profile/@username/settings" class="profile-tab @(currentTab == "Settings" ? "active" : "")">
                        <i class="fas fa-cog"></i> Settings
                    </a>
                }
            </nav>

            <!-- Tab Content -->
            <div class="profile-tab-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>