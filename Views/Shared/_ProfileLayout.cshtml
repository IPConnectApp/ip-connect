@using Microsoft.AspNetCore.Identity
@using ip_connect.Models
@using ip_connect.Services.UserProfileService
@inject UserManager<ApplicationUser> UserManager
@inject IUserProfileService ProfileService

@{
    var username = ViewData["Username"]?.ToString() ?? User.Identity?.Name ?? "";
    var currentTab = ViewData["CurrentTab"]?.ToString() ?? "Photos";
    var isOwnProfile = ViewData["IsOwnProfile"] as bool? ?? true;
    var areFriends = ViewData["AreFriends"] as bool? ?? false;
    var profilePicUrl = ViewData["ProfilePictureUrl"]?.ToString() ?? "/images/default-avatar.jpg";

    string displayName = username;
    string gender = "Not specified";
    string age = "";
    string joinedDate = "";
    string birthDateString = "";
    string bio = "";

    var user = await UserManager.FindByNameAsync(username);
    if (user != null)
    {
        var profile = await ProfileService.GetOrCreateProfileAsync(user.Id, user.UserName);

        displayName = profile.DisplayName;
        gender = profile.Gender ?? "Not specified";
        bio = profile.Bio;
        joinedDate = profile.CreatedAt.ToString("MMMM yyyy");

        //missing location

        if (profile.BirthDate.HasValue)
        {
            var today = DateTime.Today;
            var birthDate = profile.BirthDate.Value;
            var a = today.Year - birthDate.Year;
            if (birthDate.Date > today.AddYears(-a)) a--;
            age = $", {a}";

            birthDateString = profile.BirthDate.Value.ToString("dd MMMM yyyy");
        }
    }
    // Show tabs only if: own profile OR friends
    var showTabs = isOwnProfile || areFriends;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IP Connect</title>

    <link rel="stylesheet" href="~/css/variables.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/profile/profile.css" />
    <link rel="stylesheet" href="~/css/profile/settings.css" />
    <link rel="stylesheet" href="~/css/navbar-notifications.css" />
    <link rel="stylesheet" href="~/css/profile/chat.css" />
    <link rel="stylesheet" href="~/css/global-modals.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/profile/profile-badge.js"></script>
    <script src="~/js/global-signalr.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @await Html.PartialAsync("_Navbar")

    <div class="profile-container">
        <!-- Left Sidebar -->
        <aside class="profile-sidebar">
            <div class="profile-picture">
                <img src="@profilePicUrl" alt="Profile Picture" />
            </div>
            <h2 class="profile-name">@displayName</h2>

            <div class="profile-info">
                <p><i class="fas fa-venus-mars"></i> @gender@age</p>

                @if (!string.IsNullOrEmpty(birthDateString))
                {
                    <p><i class="fas fa-birthday-cake"></i> @birthDateString</p>
                }

                <p><i class="fas fa-calendar"></i> Joined @joinedDate</p>
            </div>

            <div class="profile-bio">
                <p>
                    @if (!string.IsNullOrEmpty(bio))
                    {
                        @bio
                    }
                    else
                    {
                        <span class="text-muted" style="font-style: italic; font-size: 0.9em;">
                            No bio provided yet.
                        </span>
                    }
                </p>
            </div>
        </aside>

        <!-- Right Content Area -->
        <main class="profile-content">
            @if (showTabs)
            {
                <!-- Tab Navigation (only show if friends or own profile) -->
                <nav class="profile-tabs">
                    <a href="/profile/@username/photos" class="profile-tab @(currentTab == "Photos" ? "active" : "")">
                        <i class="fas fa-images"></i> Photos
                    </a>
                    <a href="/profile/@username/friends" class="profile-tab @(currentTab == "Friends" ? "active" : "")">
                        <i class="fas fa-user-friends"></i> Friends
                    </a>

                    @if (isOwnProfile)
                    {
                        <a href="/profile/@username/chats" class="profile-tab @(currentTab == "Chats" ? "active" : "")">
                            <i class="fas fa-comments"></i> Chats
                            <span id="profileUnreadBadge" class="profile-tab-badge" style="display: none;">0</span>
                        </a>
                        <a href="/profile/@username/settings" class="profile-tab @(currentTab == "Settings" ? "active" : "")">
                            <i class="fas fa-cog"></i> Settings
                        </a>
                    }
                </nav>
            }

            <!-- Tab Content -->
            <div class="profile-tab-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Chat Modal (available on all profile pages) -->
    <div id="chatModal" class="chat-modal" style="display: none;">
        <div class="chat-modal-content">
            <!-- Modal Header -->
            <div class="chat-modal-header">
                <div class="chat-modal-user-info">
                    <img id="modalUserAvatar" src="" alt="" class="chat-modal-avatar">
                    <span id="modalUsername" class="chat-modal-username"></span>
                </div>
                <button class="chat-modal-close" onclick="closeChatModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Messages Area -->
            <div class="chat-modal-messages" id="chatMessages">
                <!-- Messages will be loaded here -->
            </div>

            <!-- Typing Indicator -->
            <div id="typingIndicator" class="typing-indicator" style="display: none;">
                <div class="typing-dots">
                    <span class="typing-dot"></span>
                    <span class="typing-dot"></span>
                    <span class="typing-dot"></span>
                </div>
                <span id="typingUsername"></span> is typing...
            </div>

            <!-- Input Area -->
            <div class="chat-modal-input">
                <button class="chat-emoji-button" id="emojiButton" type="button">
                    <i class="far fa-smile"></i>
                </button>
                <input type="text" id="messageInput" class="chat-message-input" placeholder="Type a message..."
                    autocomplete="off">
                <button class="chat-send-button" onclick="sendMessage()">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>

            <!-- Emoji Picker Container -->
            <div id="emojiPickerContainer" class="emoji-picker-container" style="display: none;">
                <emoji-picker></emoji-picker>
            </div>
        </div>
    </div>

    <!-- Pass current username to JavaScript -->
    <script>
        window.currentUsername = '@User.Identity?.Name';
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/navbar-notifications.js"></script>
    <script src="~/js/utils/emoji.js"></script>
    <script src="~/js/profile/chat.js"></script>
    <script type="module">
        import 'https://cdn.jsdelivr.net/npm/emoji-picker-element@1.21.3/index.js';
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>