<nav class="top-navbar">
    <div class="navbar-container">
        <!-- Left: Logo -->
        <div class="navbar-left">
            <a href="/" class="navbar-logo">
                <i class="fas fa-comments"></i>
                <span>IP Connect</span>
            </a>
        </div>

        <!-- Right: Notifications & Logout -->
        <div class="navbar-right">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- Notification Bell with Dropdown -->
                <div class="navbar-notification-container">
                    <a href="#" class="navbar-icon" id="notificationBell" title="Notifications">
                        <i class="fas fa-bell"></i>
                        <span class="notification-badge" id="notificationBadge" style="display: none;">0</span>
                    </a>

                    <!-- Notification Dropdown -->
                    <div class="notification-dropdown" id="notificationDropdown" style="display: none;">
                        <div class="notification-dropdown-header">
                            <h4>Notifications</h4>
                            <button class="btn-mark-all-read" id="markAllReadBtn">
                                <i class="fas fa-check-double"></i> Mark all read
                            </button>
                        </div>

                        <div class="notification-dropdown-list" id="notificationList">
                            <div class="notification-loading">
                                <i class="fas fa-spinner fa-spin"></i> Loading...
                            </div>
                        </div>

                        <div class="notification-dropdown-footer">
                            <span class="notification-footer-text">You're all caught up!</span>
                        </div>
                    </div>
                </div>

                <div class="navbar-user">
                    <a href="/profile/@User.Identity.Name" class="navbar-username">@User.Identity.Name</a>
                    <form asp-action="Logout" asp-controller="Account" method="post" class="navbar-logout-form">
                        <button type="submit" class="navbar-logout-btn">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </button>
                    </form>
                </div>
            }
            else
            {
                <a href="/account/login" class="navbar-link">Login</a>
                <a href="/account/register" class="navbar-link">Register</a>
            }
        </div>
    </div>
</nav>