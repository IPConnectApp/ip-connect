@{
    ViewData["Title"] = ViewData["AlbumName"]?.ToString() ?? "Album Details";
    Layout = "_ProfileLayout";
    var albumId = ViewData["AlbumId"];
    var isOwnProfile = (bool)(ViewData["IsOwnProfile"] ?? false);
}

<input type="hidden" id="albumId" value="@albumId" />
<input type="hidden" id="isOwnProfile" value="@isOwnProfile.ToString().ToLower()" />

<div class="album-details-container">

    <div class="album-header-section">
        <div class="album-header-left">
            <div class="album-nav-row">
                <a href="javascript:history.back()" class="btn-back-icon" title="Back to Albums">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1 class="album-title">@ViewData["AlbumName"]</h1>
            </div>

            <div class="album-meta-info">
                <span class="album-meta-item">
                    <i class="far fa-calendar-alt"></i> Created recently
                </span>
                <span class="album-meta-item">
                    <i class="far fa-images"></i> <span id="photoCountBadge">0 photos</span>
                </span>
            </div>

            @if (ViewData["AlbumDescription"] != null)
            {
                <div class="album-description-box">
                    @ViewData["AlbumDescription"]
                </div>
            }
        </div>

        @if (isOwnProfile)
        {
            <div class="album-header-actions">
                <button class="btn-action-outline" onclick="openEditAlbumModal()">
                    <i class="fas fa-pen"></i> Edit
                </button>
                <button class="btn-action-danger" onclick="confirmDeleteAlbum()">
                    <i class="fas fa-trash-alt"></i> Delete
                </button>
            </div>
        }
    </div>

    @if (isOwnProfile)
    {
        <div class="upload-container">
            <div id="photoDropArea" class="dropzone-area">
                <div class="dropzone-content">
                    <i class="fas fa-cloud-upload-alt dropzone-icon"></i>
                    <h3 class="dropzone-title">Add Photos</h3>
                    <p class="dropzone-subtitle">Drag & Drop images here or click to browse</p>
                    <p class="dropzone-subtitle text-muted" style="font-size: 12px;">Supports: JPG, PNG, WEBP (Max 10MB)</p>

                    <button type="button" id="browseFilesBtn" class="btn-select-files">
                        <i class="fas fa-plus-circle"></i> Select Files
                    </button>
                </div>

                <input type="file" id="photoFileInput" multiple accept="image/jpeg,image/png,image/gif,image/webp" hidden />
            </div>

            <div id="uploadProgress" class="upload-status-bar">
                <div class="progress-track">
                    <div class="progress-fill" id="uploadProgressBar"></div>
                </div>
                <div class="progress-text">
                    <span id="progressText">Uploading...</span>
                    <span id="progressPercent">0%</span>
                </div>
            </div>
        </div>
    }

    <div id="photoGallery" class="photos-masonry">
    </div>

    <div id="loadingIndicator" class="gallery-loader" style="display:none;">
        <i class="fas fa-circle-notch fa-spin"></i>
        <span>Loading your memories...</span>
    </div>

    <div id="emptyStateTemplate" style="display:none;">
        <div class="empty-gallery">
            <i class="far fa-image empty-gallery-icon"></i>
            <h3>No photos yet</h3>
            <p>Upload your first photo to bring this album to life.</p>
        </div>
    </div>

</div>

<div id="lightboxModal" class="lightbox-modal">
    <button class="lightbox-close" id="lightboxClose">&times;</button>
    <button class="lightbox-nav lightbox-prev" id="lightboxPrev"><i class="fas fa-chevron-left"></i></button>

    <div class="lightbox-content">
        <img id="lightboxImage" src="" alt="Full view" />
        <div class="lightbox-info">
            <span id="lightboxCounter"></span>
        </div>
    </div>

    <button class="lightbox-nav lightbox-next" id="lightboxNext"><i class="fas fa-chevron-right"></i></button>
</div>

@section Scripts {
    <script src="~/js/profile/album-photos.js"></script>
    <script>
        // Optional: Inline script to initialize tooltips or specific UI behaviors if needed
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile/album-details.css" />
}