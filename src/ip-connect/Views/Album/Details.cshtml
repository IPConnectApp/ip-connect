@{
    ViewData["Title"] = ViewData["AlbumName"]?.ToString() ?? "Album";
    Layout = "_ProfileLayout";
    var albumId = ViewData["AlbumId"];
    var isOwnProfile = (bool)(ViewData["IsOwnProfile"] ?? false);
}

<input type="hidden" id="albumId" value="@albumId" />
<input type="hidden" id="isOwnProfile" value="@isOwnProfile.ToString()" />

<div class="album-details-container">

    <!-- Album Header -->
    <div class="album-details-header">
        <a href="javascript:history.back()" class="btn-back">
            <i class="fas fa-arrow-left"></i>
            Back
        </a>

        <div class="album-details-info">
            <h1>@ViewData["AlbumName"]</h1>
        </div>
    </div>

    <!-- Photos Grid -->
    <div id="photoGallery" class="album-photos-grid">
        <!-- Photos injected by JS -->
    </div>

    <!-- Upload Section (Owner Only) -->
    @if (isOwnProfile)
    {
        <div class="upload-section">
            <div id="photoDropArea" class="upload-dropzone">
                <div class="upload-icon">
                    <i class="fas fa-cloud-upload-alt"></i>
                </div>

                <h3>Upload photos</h3>
                <p>Drag & Drop photos here</p>
                <p class="text-muted">or</p>

                <button type="button" id="browseFilesBtn" class="btn-upload">
                    <i class="fas fa-folder-open"></i>
                    Browse files
                </button>

                <input type="file"
                       id="photoFileInput"
                       multiple
                       accept="image/jpeg,image/png,image/gif,image/webp"
                       hidden />

                <p class="text-muted">
                    Supported formats: JPG, PNG, GIF, WEBP (Max 10MB)
                </p>
            </div>

            <!-- Upload Progress -->
            <div id="uploadProgress" class="upload-progress" style="display:none;">
                <div class="progress-bar-container">
                    <div class="progress-bar" id="uploadProgressBar"></div>
                </div>
                <span id="progressText">Uploading...</span>
            </div>
        </div>
    }

    <!-- Loading Indicator -->
    <div id="loadingIndicator" class="album-loading" style="display:none;">
        <i class="fas fa-spinner fa-spin"></i>
        Loading photos...
    </div>


</div>

@section Scripts {
    <script src="~/js/profile/album-photos.js"></script>
}
