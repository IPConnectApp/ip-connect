@{
    ViewData["Title"] = ViewData["AlbumName"] ?? "Album Details";
    Layout = "_ProfileLayout";
    var isOwnProfile = (bool)(ViewData["IsOwnProfile"] ?? false);
}

<div class="album-details-container">
    <div class="album-details-header">
        <button class="btn-back" onclick="history.back()">
            <i class="fas fa-arrow-left"></i> Back
        </button>
        <div class="album-details-info">
            <h1 id="albumName">Loading...</h1>
            <p id="albumDescription" class="album-description"></p>
            <span id="albumDate" class="album-date"></span>
        </div>
    </div>

    @if (isOwnProfile)
    {
        <div class="upload-section">
            <div id="dropZone" class="upload-dropzone">
                <i class="fas fa-cloud-upload-alt upload-icon"></i>
                <h3>Drag & Drop photos here</h3>
                <p>or</p>
                <label for="photoInput" class="btn-upload">
                    <i class="fas fa-folder-open"></i> Browse Files
                </label>
                <input type="file" id="photoInput" multiple accept="image/*" hidden>
            </div>
            <div id="uploadProgress" class="upload-progress" style="display: none;">
                <div class="progress-bar-container">
                    <div id="progressBar" class="progress-bar"></div>
                </div>
                <span id="progressText">Uploading...</span>
            </div>
        </div>
    }

    <div class="album-photos-grid" id="photosGrid">
        <div class="album-loading">
            <i class="fas fa-spinner fa-spin"></i> Loading photos...
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/profile/album-details.css" />
}


@section Scripts {
    <script>
        // Config passed from Razor
        window.albumConfig = {
            albumId: @ViewData["AlbumId"],
            isOwnProfile: @(isOwnProfile.ToString().ToLower())
        };

        console.log('Album Config:', window.albumConfig); // За debug
    </script>
    <script src="~/js/profile/album-details.js"></script>
}